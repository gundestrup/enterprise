<%= tabnav :kitchen %>
<p>
  <b>Title:</b>
  <%=h @recipe.title %>
</p>
<% if logged_in? %>
    <%= link_to 'Edit', edit_recipe_path(@recipe) %> |
    <%= link_to 'New', new_recipe_path %> |
<% end %>
<%= link_to 'Back', recipes_path %>

<p>
  <b>Category:</b>
  <%= link_to h(@recipe.category.name), @recipe.category %>
</p>

<b>Ingrediences:</b>
    <table id="my meal">
    <%
       odd_or_even = 0
       for meal in @meals
       odd_or_even = 1 - odd_or_even
    %>
          <tr valign="top" class="ListLine<%= odd_or_even %>">
              <td><%=h meal.quantity %></td>
              <td>
                  <%=h meal.unit.name %>
              </td>
              <td>
                  <% tooltip do %>
                            <b><%=h meal.unit.name %></b><br/>
                            <%=h meal.unit.description %><br/>
                    <% end %>
              </td>
              <td>
                  <%= link_to h(meal.ingredience.title), meal.ingredience %>
                  <% tooltip do %>
                        <b><%=h meal.ingredience.title %></b><br/>
                        <b>Description:</b><br/>
                        <%=h meal.ingredience.description %><br/>
                        <b>Weight</b><br/>
                        <%=h meal.ingredience.weight %><br/>
                  <% end %>
              </td>

              <% if logged_in? %>
                  <td><%= link_to 'Edit', edit_meal_path(meal) %></td>
                  <td><%= link_to 'Destroy', meal, :confirm => 'Are you sure?', :method => :delete %></td>
              <% end %>
          </tr>
        <% end %>
</table>
<br/>
<% if logged_in? %>
    <%= show_box_for @recipe, :link_name => "new ingredience" %>
                    <% detail_box_for @recipe do %>
                    <%= hide_box_for @recipe, :link_name => "done" %>

            <% form_remote_tag(:url => {:controller => 'meals', :action => 'create'},
                              :update => 'my meal', :position => 'bottom',
                              :html => {:id => 'meal_form'}
                              ) do  %>
            <table>
                <tr>
                    <th>quantity</th><th>Unit</th><th>ingredience</th>
                </tr>
                <tr>
                        <td><%= text_field :meal, :quantity, :maxlength => 3 %></td>
                        <td><%= collection_select("meal", "unit_id" , @units, "id", "name") %></td>
                        <td><%= collection_select("meal", "ingredience_id" , @ingrediences, "id", "title") %></td>
                    <td><%= text_field :meal, :recipe_id, :value => @recipe.id, :maxlength => 4 %></td>
                    </tr>
            </table>
            <%= submit_tag 'Add' %>
        <% end %>
    <% end %>
<% end %>
<p>
	<b>Info: </b><br/>
	KJ: <%=h @recipe.kj %> | FE: <%=h @recipe.fe %> | kcal: <%=h @recipe.kcal %><br/>
	Prep time: <%=h @recipe.time_prep %><br/>
	Work Time: <%=h @recipe.time_work %><br/>
	Freezerable?: <%=h @recipe.freezeable? %><br/>
	<br/>
  <b>Description:</b>
  <%=h @recipe.description %>    
</p>

    

<% if logged_in? %>
    <%= link_to 'Edit', edit_recipe_path(@recipe) %> |
    <%= link_to 'New', new_recipe_path %> |
<% end %>
<%= link_to 'Back', recipes_path %>